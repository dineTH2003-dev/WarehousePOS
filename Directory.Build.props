<Project>

  <PropertyGroup>
    <!-- Default target framework for domain, application, infrastructure, and test projects -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Code quality -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1903;NU1902;NU1901;NU1603;CA1512;CA1860;IDE0011;IDE0055;CA1822;IDE0040;CA1716;IDE0290;IDE0005;IDE0058;CS1591</NoWarn>
    <WarningLevel>9999</WarningLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>

    <!-- Assembly metadata -->
    <Company>WarehousePOS</Company>
    <Product>WarehousePOS</Product>
    <Copyright>Copyright © 2026</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
