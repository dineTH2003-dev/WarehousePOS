<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>WarehousePOS.Desktop</RootNamespace>
    <AssemblyName>WarehousePOS.Desktop</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <StartupObject>WarehousePOS.Desktop.App</StartupObject>
    <!-- Publishing Settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Desktop connects to Application and Infrastructure through DI.
      Desktop does NOT directly reference Domain — it goes through Application.
    -->
    <ProjectReference Include="..\WarehousePOS.Application\WarehousePOS.Application.csproj" />
    <ProjectReference Include="..\WarehousePOS.Infrastructure\WarehousePOS.Infrastructure.csproj" />
  </ItemGroup>

</Project>
