<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>WarehousePOS.Desktop</RootNamespace>
    <AssemblyName>WarehousePOS.Desktop</AssemblyName>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\Icons\app.ico</ApplicationIcon>
    <StartupObject>WarehousePOS.Desktop.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Desktop connects to Application and Infrastructure through DI.
      Desktop does NOT directly reference Domain — it goes through Application.
    -->
    <ProjectReference Include="..\WarehousePOS.Application\WarehousePOS.Application.csproj" />
    <ProjectReference Include="..\WarehousePOS.Infrastructure\WarehousePOS.Infrastructure.csproj" />
  </ItemGroup>

</Project>
