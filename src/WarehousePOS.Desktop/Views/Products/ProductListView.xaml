<Page x:Class="WarehousePOS.Desktop.Views.Products.ProductListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Products"
      KeepAlive="True"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header row -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Product Catalog" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                <TextBlock Text="Manage products, categories, pricing, and stock levels"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🏷️ Manage Categories"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ManageCategoriesCommand}"
                        Margin="0,0,10,0"
                        Height="38"
                        Padding="14,0"/>
                <Button Content="+ Add Product"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddCommand}"
                        Width="150"
                        Height="38"
                        Padding="0"/>
            </StackPanel>
        </Grid>

        <!-- Filter bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input with Hover Card -->
                <StackPanel Grid.Column="0" Width="340" Margin="0,0,16,0">
                    <TextBlock Text="Product Search" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <Border Style="{StaticResource SearchHoverCard}" Width="340" Padding="0">
                        <TextBox Style="{StaticResource SearchTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Enter SKU, name or barcode..."
                                 ToolTip="Search product catalog by name, SKU or barcode" />
                    </Border>
                </StackPanel>

                <!-- Category Filter -->
                <StackPanel Grid.Column="1" Width="340" Margin="0,0,20,0">
                    <TextBlock Text="Category" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <ComboBox Width="340"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              SelectedValue="{Binding FilterCategoryId}"
                              ItemsSource="{Binding Categories}">
                        <ComboBox.ToolTip>Filter by product category</ComboBox.ToolTip>
                    </ComboBox>
                </StackPanel>

                <!-- Right-aligned Inactive Toggle and Reset Filters -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                    <CheckBox Content="Show Inactive Products"
                              Style="{StaticResource ModernSwitch}"
                              IsChecked="{Binding ShowInactive}"
                              ToolTip="Toggle visibility of deactivated products"/>
                    <Button Content="Reset Filters"
                            Style="{StaticResource SecondaryButton}"
                            Margin="16,0,0,0"
                            Command="{Binding ClearFiltersCommand}"
                            Padding="12,6" FontSize="12"
                            ToolTip="Reset search and category filters"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Product grid -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      RowStyle="{StaticResource InactiveDataGridRow}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU"             Binding="{Binding SKU}"           Width="130"/>
                    <DataGridTemplateColumn Header="Name" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding Name}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Category"        Binding="{Binding CategoryName}"   Width="140"/>
                    <DataGridTextColumn Header="Retail (Rs.)"    Binding="{Binding RetailPrice, StringFormat=N2}"    Width="120"/>
                    <DataGridTextColumn Header="Wholesale (Rs.)" Binding="{Binding WholesalePrice, StringFormat=N2}" Width="130"/>
                    <DataGridTemplateColumn Header="Stock" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StockQuantity}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ClaimedText}"
                                               Foreground="{StaticResource DangerBrush}"
                                               FontWeight="Bold" FontSize="11"
                                               Visibility="{Binding ClaimedText, Converter={StaticResource NullToVisibilityConverter}}"
                                               ToolTip="Pending warranty claim replacement quantity from supplier"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Status" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusBadge}">
                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                               Style="{StaticResource StatusBadgeText}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Actions" Width="195">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit"
                                            Style="{StaticResource TableSecondaryButton}"
                                            Width="60" Margin="0,0,8,0"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{Binding IsActive, Converter={StaticResource BoolToToggleTextConverter}}"
                                            Style="{StaticResource TableSecondaryButton}"
                                            Width="85"
                                            Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Low-Stock Products Menu (Pinned below the list) -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#FEF2F2" Margin="0,0,12,0">
                        <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Low-Stock Products" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding LowStockCount}" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text=" product(s) currently low on stock" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <CheckBox Content="Show Low-Stock Only"
                              Style="{StaticResource ModernSwitch}"
                              IsChecked="{Binding ShowLowStockOnly}"
                              ToolTip="Filter table to display only products with low stock levels"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
