<Window x:Class="WarehousePOS.Desktop.Views.Products.ImportProductsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WarehousePOS.Desktop.Behaviors"
        Title="Bulk Import Products from CSV"
        Icon="/Resources/Images/app-icon.png"
        Height="620" Width="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Border Style="{StaticResource Card}" Margin="20" Padding="24">
        <Grid behaviors:ArrowNavigationBehavior.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Bulk Import Products" Style="{StaticResource H2}"/>
                <TextBlock Text="Upload a CSV spreadsheet to import products, stock, pricing, and categories automatically."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Instructions & Template card -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Supported Columns:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="• Product Name (Required)   • SKU / Code   • Category   • Retail Price&#x0a;• Wholesale Price   • Stock Quantity   • Reorder Level   • Barcode"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" LineHeight="16"/>
                        <TextBlock Text="* Missing categories will be created automatically. Omitted prices default to Rs. 0.00."
                                   FontSize="11" FontStyle="Italic" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="📥 Download Template"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnDownloadTemplate_Click"
                            Height="34" Padding="12,0" VerticalAlignment="Center"
                            ToolTip="Save a pre-formatted sample CSV template"/>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- File Selection -->
                    <TextBlock Text="Select CSV File *" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtFilePath" Style="{StaticResource FormTextBox}" IsReadOnly="True"
                                 Tag="No file chosen. Click Browse to select your CSV..." Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="📁 Browse..." Style="{StaticResource SecondaryButton}"
                                Click="BtnBrowse_Click" Height="38" Padding="16,0"/>
                    </Grid>

                    <!-- Import Options -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Import Options" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkUpdateExisting"
                                      Content="Update pricing if a product with the same SKU already exists"
                                      Style="{StaticResource ModernCheckBox}"
                                      IsChecked="False" Margin="0,2,0,4"/>
                            <CheckBox Content="Automatically create missing categories"
                                      Style="{StaticResource ModernCheckBox}"
                                      IsChecked="True" IsEnabled="False" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Loading / Progress Indicator -->
                    <Border x:Name="LoadingBorder" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1"
                            CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="100" Height="6" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Importing products and creating categories, please wait..."
                                       FontSize="12" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Result Summary Card -->
                    <Border x:Name="ResultBorder" CornerRadius="8" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtResultHeading" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtResultDetails" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <!-- Errors list -->
                            <TextBlock x:Name="TxtErrorsHeading" Text="Warnings / Errors:" FontWeight="SemiBold" FontSize="11"
                                       Foreground="{StaticResource DangerBrush}" Margin="0,4,0,4" Visibility="Collapsed"/>
                            <ListBox x:Name="LstErrors" MaxHeight="120" Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}"
                                     BorderThickness="1" FontSize="11" Foreground="{StaticResource DangerBrush}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Actions -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Click="BtnCancel_Click" HorizontalAlignment="Left" Width="100" Height="38"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnClose" Content="Done / Close" Style="{StaticResource SecondaryButton}"
                            Click="BtnClose_Click" Height="38" Width="120" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <Button x:Name="BtnImport" Content="🚀 Import Products" Style="{StaticResource PrimaryButton}"
                            Click="BtnImport_Click" Height="38" Width="160"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
