<Window x:Class="WarehousePOS.Desktop.Views.Products.CategoryQuickAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Category"
        Height="420" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Border Style="{StaticResource Card}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Add New Product Category" Style="{StaticResource H3}" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="1">
                <!-- Category Name -->
                <TextBlock Text="Category Name *" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtName" Style="{StaticResource FormTextBox}" TextChanged="TxtName_TextChanged" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtNameInlineError" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,0,0,10"
                           Visibility="Collapsed" TextWrapping="Wrap"/>

                <!-- Description with Redirect Header -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Description" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="🔗 Go to Category Page"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnOpenFullPage_Click"
                            FontSize="11" Padding="8,2"
                            ToolTip="Redirect to Category Management page"/>
                </Grid>

                <TextBox x:Name="TxtDescription" Style="{StaticResource FormTextBox}"
                         Height="64" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,4"/>

                <!-- Redirect inline hint link -->
                <TextBlock Margin="0,2,0,12" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                    Need full category controls? <Hyperlink Click="BtnOpenFullPage_Click" Foreground="{StaticResource PrimaryBrush}">Redirect to Category Page ⚙️</Hyperlink>
                </TextBlock>

                <!-- Error Message -->
                <Border x:Name="ErrorBorder" Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- Footer buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button Content="Save Category" Style="{StaticResource PrimaryButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
