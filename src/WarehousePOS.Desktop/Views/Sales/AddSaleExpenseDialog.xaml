<Window x:Class="WarehousePOS.Desktop.Views.Sales.AddSaleExpenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WarehousePOS.Desktop.Behaviors"
        Title="Record Bill Extra Outcome / Expense"
        Icon="/Resources/Images/app-icon.png"
        SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Border Style="{StaticResource Card}" Margin="20" Padding="20">
        <StackPanel behaviors:ArrowNavigationBehavior.IsEnabled="True">
            <!-- Header -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Record Bill Outcome / Expense" Style="{StaticResource H3}"/>
                <TextBlock x:Name="InvoiceHeaderInfo" Text="Linked to Invoice #123"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                <TextBlock Text="Record extra delivery charges, damages, packaging fees, or third-party expenses for this bill."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Inputs -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Expense Category *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbCategory" DisplayMemberPath="Name" SelectedValuePath="Id" Height="36" Margin="0,0,0,12"/>

                <TextBlock Text="Outcome Amount (Rs.) *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtAmount" Style="{StaticResource FormTextBox}" MinHeight="36" Margin="0,0,0,12"
                         behaviors:IntegerOnlyBehavior.IsEnabled="True"/>

                <TextBlock Text="Description / Reason *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDescription" Style="{StaticResource FormTextBox}" MinHeight="36" Margin="0,0,0,12"
                         Tag="e.g., Courier fee for Colombo delivery, transit damage compensation..."/>

                <TextBlock Text="Reference / Tracking No (Optional)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtReference" Style="{StaticResource FormTextBox}" MinHeight="36"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button Content="Save Outcome Expense" Style="{StaticResource DangerButton}" Click="BtnSubmit_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
