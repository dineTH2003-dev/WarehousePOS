<Window x:Class="WarehousePOS.Desktop.Views.Sales.CustomerFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WarehousePOS.Desktop.Behaviors"
        Title="{Binding Title}"
        Height="460" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Border Style="{StaticResource Card}" Margin="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource H3}" Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="1">
                <StackPanel>
                    <TextBlock Text="Customer Name *" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="Customer Type *" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding SaleTypes}"
                              SelectedItem="{Binding Type}"
                              Margin="0,0,0,14"/>

                    <TextBlock Text="Phone" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             behaviors:DigitsOnlyBehavior.IsEnabled="True"
                             MaxLength="10"
                             Style="{StaticResource FormTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="Email" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="Address" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             Height="64" AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <Border Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="13" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
