<Page x:Class="WarehousePOS.Desktop.Views.Sales.CustomerPurchasedItemsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Customer Purchased Items"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Purchased Items — " Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding Customer.Name}" Style="{StaticResource H2}" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Phone: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Customer.Phone, TargetNullValue='N/A'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,16,0"/>

                    <TextBlock Text="Email: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Customer.Email, TargetNullValue='N/A'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,16,0"/>

                    <TextBlock Text="Discount Rate: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Customer.DiscountRate, StringFormat='{}{0:G29}%'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Content="← Back to Customers"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding BackCommand}"
                    VerticalAlignment="Top" Padding="14,8"/>
        </Grid>

        <!-- Error notification -->
        <Border Grid.Row="1" Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="13"/>
        </Border>

        <!-- Data Grid Card -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding PurchasedItems}"
                          Visibility="{Binding HasNoItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="100"/>
                        <DataGridTextColumn Header="Purchase Date" Binding="{Binding PurchaseDateFormatted}" Width="120"/>
                        <DataGridTextColumn Header="Purchase Time" Binding="{Binding PurchaseTimeFormatted}" Width="110"/>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="130"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="65"/>
                        <DataGridTextColumn Header="Warranty Period" Binding="{Binding WarrantyPeriodText}" Width="130"/>
                        <DataGridTextColumn Header="Warranty Expiry Date" Binding="{Binding WarrantyExpiryText}" Width="160"/>
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WarrantyStatus}" Value="Active">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding WarrantyStatus}" Value="Expired">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding WarrantyStatus}" Value="No Warranty">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding WarrantyStatus}" FontWeight="SemiBold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WarrantyStatus}" Value="Active">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding WarrantyStatus}" Value="Expired">
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding WarrantyStatus}" Value="No Warranty">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Action" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Claim"
                                            Style="{StaticResource DangerButton}"
                                            Padding="10,4" FontSize="11"
                                            IsEnabled="{Binding CanClaim}"
                                            Command="{Binding DataContext.ClaimCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Submit a warranty liability claim for this purchased item"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32"
                            Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="🛍️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No Purchased Items Found" Style="{StaticResource H3}" HorizontalAlignment="Center"/>
                    <TextBlock Text="This customer has not purchased any products yet."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
