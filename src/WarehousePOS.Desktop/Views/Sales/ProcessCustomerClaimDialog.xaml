<Window x:Class="WarehousePOS.Desktop.Views.Sales.ProcessCustomerClaimDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WarehousePOS.Desktop.Behaviors"
        Title="Process Customer Product Claim"
        Icon="/Resources/Images/app-icon.png"
        SizeToContent="Height" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Border Style="{StaticResource Card}" Margin="20" Padding="20">
        <StackPanel behaviors:ArrowNavigationBehavior.IsEnabled="True">
            <!-- Header -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📝 " FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="Process Customer Product Claim" Style="{StaticResource H3}"/>
                </StackPanel>
                <TextBlock Text="Record product defect, warranty, or return claim details including claim amount and reason."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Separator Margin="0,0,0,16"/>

            <!-- Form Body -->
            <StackPanel Margin="0,0,0,16">
                <!-- Customer Selection -->
                <TextBlock Text="Customer (Optional)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbCustomers" DisplayMemberPath="DisplayName" Height="38" Margin="0,0,0,14" Style="{StaticResource FormComboBox}"/>

                <!-- Product Selection -->
                <TextBlock Text="Select Product *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbProducts" DisplayMemberPath="DisplayName" Height="38" Margin="0,0,0,14" Style="{StaticResource FormComboBox}" SelectionChanged="CmbProducts_SelectionChanged"/>

                <!-- Grid for Quantity and Claim Amount -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Quantity -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Claim Quantity *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtQuantity" Style="{StaticResource FormTextBox}" MinHeight="38" Text="1"
                                 behaviors:IntegerOnlyBehavior.IsEnabled="True" TextChanged="TxtQuantity_TextChanged"/>
                    </StackPanel>

                    <!-- Claim Amount (Rs.) -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Claim Amount (Rs.) *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtClaimAmount" Style="{StaticResource FormTextBox}" MinHeight="38" Text="0.00"/>
                    </StackPanel>
                </Grid>

                <!-- Claim Reason Preset Dropdown -->
                <TextBlock Text="Claim Reason / Type *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbReasons" Height="38" Margin="0,0,0,14" Style="{StaticResource FormComboBox}">
                    <ComboBoxItem Content="Defective / Damaged Product" IsSelected="True"/>
                    <ComboBoxItem Content="Warranty Liability Claim"/>
                    <ComboBoxItem Content="Customer Return &amp; Refund Request"/>
                    <ComboBoxItem Content="Damaged in Transit"/>
                    <ComboBoxItem Content="Missing Parts / Accessories"/>
                    <ComboBoxItem Content="Other / Custom Reason"/>
                </ComboBox>

                <!-- Custom Reason / Detailed Notes -->
                <TextBlock Text="Additional Notes / Claim Details" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNotes" Style="{StaticResource FormTextBox}" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Height="38" Padding="18,0" Click="BtnCancel_Click"/>
                <Button Content="Submit &amp; Process Claim" Style="{StaticResource DangerButton}" Height="38" Padding="20,0" Click="BtnSubmit_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
