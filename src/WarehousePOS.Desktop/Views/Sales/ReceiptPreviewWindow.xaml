<Window x:Class="WarehousePOS.Desktop.Views.Sales.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt Print Preview — Epson LQ-310"
        Height="620" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <TextBlock Grid.Row="0" Text="Receipt Print Preview" Style="{StaticResource H3}" Margin="0,0,0,12" HorizontalAlignment="Center"/>

        <!-- Receipt Content Display Card (Simulates Thermal/Dot-Matrix paper) -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtReceiptText"
                           FontFamily="Consolas, Courier New"
                           FontSize="13"
                           Foreground="Black"
                           TextWrapping="NoWrap"
                           LineHeight="18"/>
            </ScrollViewer>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click" Margin="0,0,10,0"/>
            <Button Content="Print to Epson LQ-310" Style="{StaticResource SuccessButton}" Click="Print_Click"/>
        </StackPanel>
    </Grid>
</Window>
