<Window x:Class="WarehousePOS.Desktop.Views.Suppliers.SupplierFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WarehousePOS.Desktop.Behaviors"
        Title="{Binding Title}"
        Height="620" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Border Style="{StaticResource Card}" Margin="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource H3}" Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Supplier Name -->
                    <TextBlock Text="Supplier Name *" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding NameError}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,0,0,10"
                               Visibility="{Binding NameError, Converter={StaticResource NullToVisibilityConverter}}" TextWrapping="Wrap"/>

                    <!-- Contact Person -->
                    <TextBlock Text="Contact Person" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}" Margin="0,0,0,14"/>

                    <!-- Phone & Email -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Phone" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:DigitsOnlyBehavior.IsEnabled="True"
                                     MaxLength="10"
                                     Style="{StaticResource FormTextBox}"/>
                            <TextBlock Text="{Binding PhoneError}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,4,0,0"
                                       Visibility="{Binding PhoneError, Converter={StaticResource NullToVisibilityConverter}}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"/>
                            <TextBlock Text="{Binding EmailError}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,4,0,0"
                                       Visibility="{Binding EmailError, Converter={StaticResource NullToVisibilityConverter}}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Address -->
                    <TextBlock Text="Address" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             Height="54" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- ── What product does this person provide? (Mandatory Section) ── -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="What product does this person provide? *" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="At least one product is mandatory." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,10"/>

                            <!-- Product selection / addition control -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableProducts}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedProductIdToAdd}"
                                          Margin="0,0,8,0">
                                    <ComboBox.ToolTip>Select an existing product provided by this supplier</ComboBox.ToolTip>
                                </ComboBox>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+ Add" Style="{StaticResource SecondaryButton}" Command="{Binding AddProductCommand}" Margin="0,0,6,0" Padding="10,4"/>
                                    <Button Content="✨ Create New" Style="{StaticResource PrimaryButton}" Command="{Binding CreateNewProductCommand}" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <!-- Provided Products Cards -->
                            <ItemsControl ItemsSource="{Binding ProvidedProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding SKU}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                </StackPanel>

                                                <!-- Direct link to product page -->
                                                <Button Grid.Column="1" Content="🔗 View Product Page"
                                                        Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" FontSize="11"
                                                        Command="{Binding DataContext.NavigateToProductPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>

                                                <Button Grid.Column="2" Content="✕"
                                                        Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                                        Command="{Binding DataContext.RemoveProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding ProvidedProductsError}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,6,0,0"
                                       Visibility="{Binding ProvidedProductsError, Converter={StaticResource NullToVisibilityConverter}}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <Border Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="13" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
                    <Button Content="Save Supplier" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
