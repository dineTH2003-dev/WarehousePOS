<Page x:Class="WarehousePOS.Desktop.Views.Expenses.ExpenseListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:WarehousePOS.Desktop.Converters"
      xmlns:reports="clr-namespace:WarehousePOS.Application.Reports;assembly=WarehousePOS.Application"
      Title="Warehouse Operational Expenses"
      KeepAlive="True"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <conv:CategoryToColorBrushConverter x:Key="CategoryToColorBrushConverter"/>
    </Page.Resources>

    <Grid Margin="24">
        <!-- Main Overlay Modal Container Grid -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- 1. PAGE HEADER -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#EFF6FF" Margin="0,0,10,0">
                                <TextBlock Text="📄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Warehouse Operational Expenses" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Track daily expenses, utility bills, maintenance, transport costs, and operational overhead."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    </StackPanel>

                    <!-- Top Right Quick Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅 Today: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Source={x:Static System:DateTime.Today}, StringFormat={}{0:dd MMM yyyy}}" 
                                           FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           xmlns:System="clr-namespace:System;assembly=mscorlib"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource SecondaryButton}" Padding="12,6" Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄 " FontSize="12"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. FILTER / ACTION BAR -->
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Date Preset ComboBox -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Date Preset" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding SelectedDatePreset}"
                                          SelectedValuePath="Tag" Height="36">
                                    <ComboBoxItem Content="This Month" Tag="{x:Static reports:DateRangePreset.ThisMonth}"/>
                                    <ComboBoxItem Content="Today" Tag="{x:Static reports:DateRangePreset.Today}"/>
                                    <ComboBoxItem Content="Yesterday" Tag="{x:Static reports:DateRangePreset.Yesterday}"/>
                                    <ComboBoxItem Content="Last 7 Days" Tag="{x:Static reports:DateRangePreset.Last7Days}"/>
                                    <ComboBoxItem Content="Last 30 Days" Tag="{x:Static reports:DateRangePreset.Last30Days}"/>
                                    <ComboBoxItem Content="All Time" Tag="{x:Static reports:DateRangePreset.AllTime}"/>
                                    <ComboBoxItem Content="Custom" Tag="{x:Static reports:DateRangePreset.Custom}"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- From DatePicker -->
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="From" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Height="36"/>
                            </StackPanel>

                            <!-- To DatePicker -->
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="To" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Height="36"/>
                            </StackPanel>

                            <!-- Category Filter ComboBox -->
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Category" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding FilterCategories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedCategoryFilterId}" Height="36"/>
                            </StackPanel>

                            <!-- Search Input -->
                            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                <TextBlock Text="Search Expenses" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource FormTextBox}" Height="36"/>
                            </StackPanel>

                            <!-- Filter Buttons -->
                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Apply Filter" Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0" Margin="0,0,8,0"
                                        Command="{Binding ApplyFilterCommand}"/>
                                <Button Content="Clear" Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0"
                                        Command="{Binding ClearFilterCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Filter Validation Error -->
                        <Border Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4"
                                Padding="8,6" Margin="0,8,0,0" Visibility="{Binding HasFilterValidationError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding FilterValidationError}" Foreground="{StaticResource DangerBrush}" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. KPI CARDS SECTION (4 Cards) -->
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <!-- KPI 1: Total Expenses -->
                    <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#FFE4E6" Margin="0,0,12,0">
                                <TextBlock Text="💳" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Total Expenses" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalExpensesFormatted}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,2,0,2"/>
                                <TextBlock Text="{Binding TrendText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 2: Number of Entries -->
                    <Border Style="{StaticResource Card}" Margin="3,0,3,0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#EFF6FF" Margin="0,0,12,0">
                                <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Number of Entries" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ExpenseCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,2"/>
                                <TextBlock Text="Recorded in period" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 3: Average Expense -->
                    <Border Style="{StaticResource Card}" Margin="3,0,3,0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#ECFDF5" Margin="0,0,12,0">
                                <TextBlock Text="🪙" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Average Expense" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AverageExpenseFormatted}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,2"/>
                                <TextBlock Text="per transaction" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 4: Highest Category -->
                    <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#F3E8FF" Margin="0,0,12,0">
                                <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Highest Category" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding HighestCategoryName}" FontSize="16" FontWeight="Bold" Foreground="#7C3AED" TextTrimming="CharacterEllipsis" Margin="0,2,0,2"/>
                                <TextBlock Text="{Binding HighestCategorySubtext}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- 4. ANALYTICS CARDS (2 Cards: Category Donut & Monthly Trend) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Analytics: Expenses by Category -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Expenses by Category" Style="{StaticResource H3}" Margin="0,0,0,16"/>

                            <Grid Height="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Custom Native Donut Representation -->
                                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="140" Height="140" Stroke="#3B82F6" StrokeThickness="22"/>
                                    <Ellipse Width="94" Height="94" Fill="White"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalExpensesFormatted}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Total" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Category List Legend -->
                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CategoryBreakdownItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="45"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TotalAmountFormatted}" FontSize="12" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding PercentageFormatted}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right Analytics: Monthly Expense Trend Column Chart -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Monthly Expense Trend" Style="{StaticResource H3}" Margin="0,0,0,16"/>

                            <Grid Height="180">
                                <ItemsControl ItemsSource="{Binding MonthlyTrendItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="12" VerticalAlignment="Bottom"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" ToolTip="{Binding TooltipText}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Vertical Column Bar -->
                                                <Border Grid.Row="0" Width="14" Height="{Binding BarHeight}" CornerRadius="3,3,0,0" VerticalAlignment="Bottom">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#3B82F6"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActiveMonth}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <!-- Month Label -->
                                                <TextBlock Grid.Row="1" Text="{Binding MonthLabel}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" 
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 5. MAIN CONTENT SPLIT (Left: Records DataGrid, Right: Form & Quick Cards) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Expense Records Table -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                            <StackPanel>
                                <!-- Table Header Bar -->
                                <Border Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Expense Records" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                                            <Border Background="#EFF6FF" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding ExpenseCount}" FontSize="12" FontWeight="Bold" Foreground="#3B82F6"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- DataGrid Table -->
                                <DataGrid ItemsSource="{Binding Expenses}" AutoGenerateColumns="False" IsReadOnly="True" 
                                          SelectedItem="{Binding SelectedExpense, Mode=TwoWay}"
                                          Height="340">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate, Converter={StaticResource UtcToLocalDateTimeConverter}}" Width="150"/>
                                        
                                        <!-- Category Pill Badge Column -->
                                        <DataGridTemplateColumn Header="Category" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Left"
                                                            Background="{Binding CategoryName, Converter={StaticResource CategoryToColorBrushConverter}}">
                                                        <TextBlock Text="{Binding CategoryName}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                        <DataGridTextColumn Header="Ref #" Binding="{Binding ReferenceNo}" Width="90"/>
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=Rs. {0:N2}}" Width="110"/>
                                        <DataGridTextColumn Header="Created By" Binding="{Binding CreatedBy}" Width="100"/>

                                        <!-- Actions Column -->
                                        <DataGridTemplateColumn Header="Actions" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <!-- Edit Button -->
                                                        <Button Style="{StaticResource SecondaryButton}" Padding="6,2" Height="24" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}" ToolTip="Edit Expense">
                                                            <TextBlock Text="✏" FontSize="11"/>
                                                        </Button>
                                                        <!-- Delete Button -->
                                                        <Button Style="{StaticResource SecondaryButton}" Padding="6,2" Height="24" Foreground="{StaticResource DangerBrush}"
                                                                Command="{Binding DataContext.PromptDeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}" ToolTip="Delete Expense">
                                                            <TextBlock Text="🗑" FontSize="11"/>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Table Footer Summary -->
                                <Border Padding="16,8" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <TextBlock Text="{Binding RecordCountSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- RIGHT COLUMN: Record/Edit Form & Quick Cards -->
                    <StackPanel Grid.Column="2">

                        <!-- Form Card -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding FormTitle}" Style="{StaticResource H3}"/>
                                <TextBlock Text="{Binding FormSubtitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,12"/>

                                <!-- Success Notification Banner -->
                                <Border Background="#ECFDF5" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                        Visibility="{Binding HasSuccessMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Form Error Banner -->
                                <Border Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                        Visibility="{Binding HasFormErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding FormErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Date Picker -->
                                <TextBlock Text="Date *" Style="{StaticResource FormLabel}"/>
                                <DatePicker SelectedDate="{Binding FormExpenseDate, Mode=TwoWay}" Height="36" Margin="0,0,0,10"/>

                                <!-- Category ComboBox -->
                                <TextBlock Text="Category *" Style="{StaticResource FormLabel}"/>
                                <ComboBox ItemsSource="{Binding FormCategories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectedValue="{Binding FormCategoryId}" Height="36" Margin="0,0,0,10"/>

                                <!-- Description Multi-line TextBox -->
                                <TextBlock Text="Description *" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource FormTextBox}" Height="54" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <!-- Reference No TextBox -->
                                <TextBlock Text="Reference #" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FormReferenceNo, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource FormTextBox}" Height="34" Margin="0,0,0,10"/>

                                <!-- Amount Input & Error -->
                                <TextBlock Text="Amount (Rs.) *" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FormAmountText, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource FormTextBox}" Height="36" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding FormAmountError}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,0,0,10"
                                           Visibility="{Binding HasFormAmountError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Form Buttons -->
                                <Button Content="{Binding FormSubmitButtonText}" Style="{StaticResource PrimaryButton}" Height="38"
                                        Command="{Binding SaveExpenseCommand}" Margin="0,6,0,0"/>

                                <Button Content="Cancel Edit" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,6,0,0"
                                        Command="{Binding CancelEditCommand}"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Quick Actions Card -->
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="⚡ Quick Actions" Style="{StaticResource H3}" FontSize="13" Margin="0,0,0,8"/>
                                <Button Content="📅 View This Month" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,0,6" Command="{Binding QuickThisMonthCommand}"/>
                                <Button Content="📊 View Last 3 Months" Style="{StaticResource SecondaryButton}" Height="32" Command="{Binding QuickLast3MonthsCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Insight Tip Card -->
                        <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💡 " FontSize="14" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding InsightText}" Foreground="#166534" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 6. MODAL OVERLAY: Delete Confirmation Dialog -->
        <Grid Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVisibilityConverter}}" Panel.ZIndex="1000">
            <Border Background="#80000000"/>
            <Border Style="{StaticResource Card}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="Delete Expense Entry?" Style="{StaticResource H2}" FontSize="16" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Are you sure you want to delete this operational expense record?" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                    <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding ExpenseToDelete.CategoryName, StringFormat=Category: {0}}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ExpenseToDelete.Description, StringFormat=Description: {0}}" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ExpenseToDelete.Amount, StringFormat=Amount: Rs. {0:N2}}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,6,0"
                                Command="{Binding CancelDeleteCommand}"/>
                        <Button Grid.Column="1" Content="Delete" Style="{StaticResource DangerButton}" Height="36" Margin="6,0,0,0"
                                Command="{Binding ConfirmDeleteCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
