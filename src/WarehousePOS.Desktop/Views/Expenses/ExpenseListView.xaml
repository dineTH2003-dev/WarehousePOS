<Page x:Class="WarehousePOS.Desktop.Views.Expenses.ExpenseListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:WarehousePOS.Desktop.Converters"
      xmlns:reports="clr-namespace:WarehousePOS.Application.Reports;assembly=WarehousePOS.Application"
      xmlns:behaviors="clr-namespace:WarehousePOS.Desktop.Behaviors"
      xmlns:controls="clr-namespace:WarehousePOS.Desktop.Controls"
      Title="Warehouse Operational Expenses"
      KeepAlive="True"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <conv:CategoryToColorBrushConverter x:Key="CategoryToColorBrushConverter"/>
    </Page.Resources>

    <Grid Margin="24" behaviors:ArrowNavigationBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. PAGE HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#EFF6FF" Margin="0,0,10,0">
                        <TextBlock Text="📄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Warehouse Operational Expenses" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Track daily expenses, utility bills, maintenance, transport costs, and operational overhead."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
            </StackPanel>

            <!-- Top Right Quick Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📅 Today: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Source={x:Static System:DateTime.Today}, StringFormat={}{0:dd MMM yyyy}}" 
                                   FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   xmlns:System="clr-namespace:System;assembly=mscorlib"/>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource SecondaryButton}" Padding="12,6" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄 " FontSize="12"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. FILTER / ACTION BAR -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,10,16,4" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <!-- Date Preset ComboBox -->
                    <StackPanel Width="145" Margin="0,0,8,6">
                        <TextBlock Text="Date Preset" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding SelectedDatePreset}"
                                  SelectedValuePath="Tag" Height="36">
                            <ComboBoxItem Content="This Month" Tag="{x:Static reports:DateRangePreset.ThisMonth}"/>
                            <ComboBoxItem Content="Today" Tag="{x:Static reports:DateRangePreset.Today}"/>
                            <ComboBoxItem Content="Yesterday" Tag="{x:Static reports:DateRangePreset.Yesterday}"/>
                            <ComboBoxItem Content="Last 7 Days" Tag="{x:Static reports:DateRangePreset.Last7Days}"/>
                            <ComboBoxItem Content="Last 30 Days" Tag="{x:Static reports:DateRangePreset.Last30Days}"/>
                            <ComboBoxItem Content="All Time" Tag="{x:Static reports:DateRangePreset.AllTime}"/>
                            <ComboBoxItem Content="Custom" Tag="{x:Static reports:DateRangePreset.Custom}"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- From DatePicker -->
                    <StackPanel Width="135" Margin="0,0,8,6">
                        <TextBlock Text="From" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Height="36"/>
                    </StackPanel>

                    <!-- To DatePicker -->
                    <StackPanel Width="135" Margin="0,0,8,6">
                        <TextBlock Text="To" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Height="36"/>
                    </StackPanel>

                    <!-- Category Filter ComboBox -->
                    <StackPanel Width="170" Margin="0,0,8,6">
                        <TextBlock Text="Category" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding FilterCategories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedCategoryFilterId}" Height="36"/>
                    </StackPanel>

                    <!-- Search Input -->
                    <StackPanel Width="200" Margin="0,0,8,6">
                        <TextBlock Text="Search Expenses" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource FormTextBox}" Height="36"/>
                    </StackPanel>

                    <!-- Filter Buttons -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <Button Content="Apply Filter" Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0" Margin="0,0,8,0"
                                Command="{Binding ApplyFilterCommand}"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0"
                                Command="{Binding ClearFilterCommand}"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Filter Validation Error -->
                <Border Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4"
                        Padding="8,6" Margin="0,4,0,6" Visibility="{Binding HasFilterValidationError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding FilterValidationError}" Foreground="{StaticResource DangerBrush}" FontSize="12"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 3. MAIN CONTENT AREA -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: KPI Cards + Analytics + Expense Records Table -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- KPI CARDS SECTION (4 Cards) -->
                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                    <!-- KPI 1: Total Expenses -->
                    <Border x:Name="TotalExpensesCard" Style="{StaticResource Card}" Margin="0,0,4,0" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#FFE4E6" Margin="0,0,10,0">
                                <TextBlock Text="💳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Total Expenses" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalExpensesFormatted}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,1,0,1"/>
                                <TextBlock Text="{Binding TrendText}" FontSize="10" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 2: Number of Entries -->
                    <Border Style="{StaticResource Card}" Margin="2,0,2,0" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#EFF6FF" Margin="0,0,10,0">
                                <TextBlock Text="📄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Number of Entries" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ExpenseCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,1,0,1"/>
                                <TextBlock Text="Recorded in period" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 3: Average Expense -->
                    <Border Style="{StaticResource Card}" Margin="2,0,2,0" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#ECFDF5" Margin="0,0,10,0">
                                <TextBlock Text="🪙" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Average Expense" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AverageExpenseFormatted}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,1,0,1"/>
                                <TextBlock Text="per transaction" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 4: Highest Category -->
                    <Border Style="{StaticResource Card}" Margin="4,0,0,0" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#F3E8FF" Margin="0,0,10,0">
                                <TextBlock Text="📊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Highest Category" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding HighestCategoryName}" FontSize="14" FontWeight="Bold" Foreground="#7C3AED" TextTrimming="CharacterEllipsis" Margin="0,1,0,1"/>
                                <TextBlock Text="{Binding HighestCategorySubtext}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ANALYTICS CARDS (Category Donut & Monthly Trend) -->
                <Grid Grid.Row="1" Margin="0,0,0,10" Height="190">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Analytics: Expenses by Category -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="Expenses by Category" Style="{StaticResource H3}" FontSize="13" Margin="0,0,0,8"/>

                            <Grid Height="145">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Multi-Colored Native Donut Chart Representation -->
                                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:DonutPieChart Width="104" Height="104" ItemsSource="{Binding CategoryBreakdownItems}"/>
                                    <Ellipse Width="72" Height="72" Fill="White" IsHitTestVisible="False"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding TotalExpensesFormatted}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Total" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Category List Legend -->
                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CategoryBreakdownItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding ColorBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TotalAmountFormatted}" FontSize="11" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding PercentageFormatted}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right Analytics: Monthly Expense Trend Column Chart -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="Monthly Expense Trend" Style="{StaticResource H3}" FontSize="13" Margin="0,0,0,8"/>

                            <Grid Height="145">
                                <ItemsControl ItemsSource="{Binding MonthlyTrendItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="12" VerticalAlignment="Bottom"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" ToolTip="{Binding TooltipText}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Vertical Column Bar -->
                                                <Border Grid.Row="0" Width="15" Height="{Binding BarHeight}" CornerRadius="3,3,0,0" VerticalAlignment="Bottom">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#3B82F6"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActiveMonth}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <!-- Month Label -->
                                                <TextBlock Grid.Row="1" Text="{Binding MonthLabel}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" 
                                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- EXPENSE RECORDS TABLE (Fills remaining height and scrolls internally) -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Table Header Bar -->
                        <Border Grid.Row="0" Padding="14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Expense Records" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                                    <Border Background="#EFF6FF" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding ExpenseCount}" FontSize="12" FontWeight="Bold" Foreground="#3B82F6"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DataGrid Table -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Expenses}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  SelectedItem="{Binding SelectedExpense, Mode=TwoWay}"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate, Converter={StaticResource UtcToLocalDateTimeConverter}}" Width="140"/>
                                
                                <!-- Category Pill Badge Column -->
                                <DataGridTemplateColumn Header="Category" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="6,2" HorizontalAlignment="Left"
                                                    Background="{Binding CategoryName, Converter={StaticResource CategoryToColorBrushConverter}}">
                                                <TextBlock Text="{Binding CategoryName}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Ref #" Binding="{Binding ReferenceNo}" Width="85"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=Rs. {0:N2}}" Width="110"/>
                                <DataGridTextColumn Header="Created By" Binding="{Binding CreatedBy}" Width="95"/>

                                <!-- Actions Column -->
                                <DataGridTemplateColumn Header="Actions" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <!-- Edit Button -->
                                                <Button Style="{StaticResource SecondaryButton}" Padding="6,2" Height="24" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}" ToolTip="Edit Expense">
                                                    <TextBlock Text="✏" FontSize="11"/>
                                                </Button>
                                                <!-- Delete Button -->
                                                <Button Style="{StaticResource SecondaryButton}" Padding="6,2" Height="24" Foreground="{StaticResource DangerBrush}"
                                                        Command="{Binding DataContext.PromptDeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}" ToolTip="Delete Expense">
                                                    <TextBlock Text="🗑" FontSize="11"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Table Footer Summary -->
                        <Border Grid.Row="2" Padding="14,6" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding RecordCountSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: Quick Actions (top), Record Form (stretches to fill vertical space), Insight Card (bottom) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Quick Actions Card (Height matches Total Expenses card exactly) -->
                <Border Grid.Row="0" Style="{StaticResource Card}"
                        Height="{Binding ActualHeight, ElementName=TotalExpensesCard}"
                        Padding="12,0" Margin="0,0,0,10">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="⚡ Quick Actions" Style="{StaticResource H3}" FontSize="12" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="📅 This Month" Style="{StaticResource SecondaryButton}" Height="28"
                                    Padding="4,0" FontSize="11"
                                    Command="{Binding QuickThisMonthCommand}" ToolTip="Filter expenses for this month"/>
                            <Button Grid.Column="2" Content="📊 Last 3 Months" Style="{StaticResource SecondaryButton}" Height="28"
                                    Padding="4,0" FontSize="11"
                                    Command="{Binding QuickLast3MonthsCommand}" ToolTip="Filter expenses for last 3 months"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Form Card (Stretches vertically to fill all available space seamlessly) -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Banners -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource H3}" FontSize="13"/>
                            <TextBlock Text="{Binding FormSubtitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,1,0,6"/>

                            <!-- Success Notification Banner -->
                            <Border Background="#ECFDF5" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6"
                                    Visibility="{Binding HasSuccessMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Form Error Banner -->
                            <Border Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6"
                                    Visibility="{Binding HasFormErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding FormErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>

                        <!-- Date Picker -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,6">
                            <TextBlock Text="Date *" Style="{StaticResource FormLabel}" FontSize="11" Margin="0,0,0,2"/>
                            <DatePicker SelectedDate="{Binding FormExpenseDate, Mode=TwoWay}" Height="34"/>
                        </StackPanel>

                        <!-- Category ComboBox -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,6">
                            <TextBlock Text="Category *" Style="{StaticResource FormLabel}" FontSize="11" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding FormCategories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding FormCategoryId}" Height="34"/>
                        </StackPanel>

                        <!-- Description Multi-line TextBox (Expands to absorb available vertical space!) -->
                        <Grid Grid.Row="3" Margin="0,0,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Description *" Style="{StaticResource FormLabel}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox Grid.Row="1" Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource FormTextBox}" MinHeight="46" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalAlignment="Stretch" VerticalContentAlignment="Top"/>
                        </Grid>

                        <!-- Reference No TextBox -->
                        <StackPanel Grid.Row="4" Margin="0,0,0,6">
                            <TextBlock Text="Reference #" Style="{StaticResource FormLabel}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding FormReferenceNo, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource FormTextBox}" Height="34" MinHeight="34"/>
                        </StackPanel>

                        <!-- Amount Input & Error -->
                        <StackPanel Grid.Row="5" Margin="0,0,0,8">
                            <TextBlock Text="Amount (Rs.) *" Style="{StaticResource FormLabel}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding FormAmountText, UpdateSourceTrigger=PropertyChanged}" 
                                     behaviors:DecimalOnlyBehavior.IsEnabled="True"
                                     Style="{StaticResource FormTextBox}" Height="34" MinHeight="34"/>
                            <TextBlock Text="{Binding FormAmountError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,2,0,0"
                                       Visibility="{Binding HasFormAmountError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- Form Buttons -->
                        <StackPanel Grid.Row="6">
                            <Button Content="{Binding FormSubmitButtonText}" Style="{StaticResource PrimaryButton}" Height="36"
                                    Command="{Binding SaveExpenseCommand}"/>

                            <Button Content="Cancel Edit" Style="{StaticResource SecondaryButton}" Height="28" Margin="0,4,0,0"
                                    Command="{Binding CancelEditCommand}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Insight Tip Card (Anchored at bottom, with wrapped text for complete visibility) -->
                <Border Grid.Row="2" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💡" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding InsightText}" Foreground="#166534" FontSize="11" TextWrapping="Wrap" LineHeight="16" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. MODAL OVERLAY: Delete Confirmation Dialog -->
        <Grid Grid.RowSpan="3" Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVisibilityConverter}}" Panel.ZIndex="1000">
            <Border Background="#80000000"/>
            <Border Style="{StaticResource Card}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="Delete Expense Entry?" Style="{StaticResource H2}" FontSize="16" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Are you sure you want to delete this operational expense record?" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                    <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding ExpenseToDelete.CategoryName, StringFormat=Category: {0}}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ExpenseToDelete.Description, StringFormat=Description: {0}}" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ExpenseToDelete.Amount, StringFormat=Amount: Rs. {0:N2}}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,6,0"
                                Command="{Binding CancelDeleteCommand}"/>
                        <Button Grid.Column="1" Content="Delete" Style="{StaticResource DangerButton}" Height="36" Margin="6,0,0,0"
                                Command="{Binding ConfirmDeleteCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
