<Page x:Class="WarehousePOS.Desktop.Views.Users.UserManagementView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:WarehousePOS.Desktop.Behaviors"
      Title="User Management"
      KeepAlive="True"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24" behaviors:ArrowNavigationBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="User Management" Style="{StaticResource H2}"/>
            <TextBlock Text="Manage system accounts, user roles, authentication, and permissions"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Users List Card -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Users / Employees" Style="{StaticResource H3}"/>
                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Height="32" Padding="14,4" Command="{Binding RefreshCommand}" HorizontalAlignment="Right"/>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True" RowStyle="{StaticResource InactiveDataGridRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90"/>
                            <DataGridTextColumn Header="Base Salary" Binding="{Binding BaseSalary, StringFormat=Rs. {0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding PaymentDueDate, TargetNullValue='—'}" Width="95"/>
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadge}">
                                            <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                                       Style="{StaticResource StatusBadgeText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding IsActive, Converter={StaticResource BoolToToggleTextConverter}}"
                                                Style="{StaticResource TableSecondaryButton}"
                                                Width="85"
                                                Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Column: Add/Edit User Form Card -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="680">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource H3}" Margin="0,0,0,14"/>

                        <Border Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                        </Border>
                        <Border Background="#F0FDF4" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Username *" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Username}" IsReadOnly="{Binding IsEditing}" Style="{StaticResource FormTextBox}" Margin="0,0,0,10"/>

                        <TextBlock Text="Full Name *" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,10"/>

                        <TextBlock Text="Password" Style="{StaticResource FormLabel}"/>
                        <Border x:Name="PasswordContainer"
                                Height="38"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Masked Password -->
                                <PasswordBox x:Name="PasswordBox"
                                             Grid.Column="0"
                                             FontSize="14"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             PasswordChanged="PasswordBox_PasswordChanged"
                                             GotFocus="PasswordControl_GotFocus"
                                             LostFocus="PasswordControl_LostFocus" />

                                <!-- Plain Text Password (when eye icon toggled) -->
                                <TextBox x:Name="PasswordTextBox"
                                         Grid.Column="0"
                                         FontSize="14"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         Visibility="Collapsed"
                                         TextChanged="PasswordTextBox_TextChanged"
                                         GotFocus="PasswordControl_GotFocus"
                                         LostFocus="PasswordControl_LostFocus" />

                                <!-- Eye Icon Toggle Button -->
                                <Button x:Name="TogglePasswordButton"
                                        Grid.Column="1"
                                        Style="{StaticResource PasswordEyeToggleButtonStyle}"
                                        Width="34"
                                        Height="34"
                                        Margin="0,0,2,0"
                                        ToolTip="Show password"
                                        Click="TogglePasswordButton_Click">
                                    <Path x:Name="EyeIconPath"
                                          Data="{StaticResource EyeOpenIcon}"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          Width="16"
                                          Height="16"
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Text="Role *" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" Margin="0,0,0,14"/>

                        <Separator Margin="0,4,0,12"/>

                        <!-- 💰 Employee Salary & Payroll Section -->
                        <TextBlock Text="💰 Basic Salary &amp; Payroll Parameters" Style="{StaticResource FormLabel}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="Basic Salary (Rs.)" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding BaseSalary, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Margin="0,0,0,10"/>

                        <TextBlock Text="Salary Components" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding SalaryComponents, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,10" Tag="e.g. Basic + Allowance + Bonus"/>

                        <TextBlock Text="Payment Due Date" Style="{StaticResource FormLabel}"/>
                        <DatePicker SelectedDate="{Binding PaymentDueDate, Mode=TwoWay}"
                                    DisplayDateStart="{Binding MinDueDate, Mode=OneWay}"
                                    Height="38" Margin="0,0,0,10" VerticalContentAlignment="Center"
                                    ToolTip="Select payment due date (today or future date)"/>

                        <TextBlock Text="Payment Frequency" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding PaymentFrequencies}" SelectedItem="{Binding PaymentFrequency}" Margin="0,0,0,16" ToolTip="Select payment payout frequency (e.g., Monthly, Weekly, Daily)"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Content="Clear" Style="{StaticResource SecondaryButton}" Width="80" Height="36" Command="{Binding ClearCommand}" Margin="0,0,8,0"/>
                            <Button Content="{Binding SaveButtonText}" Style="{StaticResource PrimaryButton}" MinWidth="110" Height="36" Command="{Binding SaveCommand}" Padding="16,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
