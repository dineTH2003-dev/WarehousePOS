<Page x:Class="WarehousePOS.Desktop.Views.Purchasing.PurchasingView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:WarehousePOS.Desktop.Behaviors"
      Title="Purchasing"
      KeepAlive="True"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24" behaviors:ArrowNavigationBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Top Header ─────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Purchasing &amp; Stock Inbound" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                <TextBlock Text="Create purchase orders, receive supplier stock, record discounts &amp; free items, and track supplier entitlements"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ── Supplier & Payment Section ─────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Supplier, Payment Method, Purchase Notes -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Supplier Selection -->
                    <StackPanel Grid.Column="0">
                        <Grid Width="340" Height="24" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Select Supplier *" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="🎁 Record Benefit"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding RecordEntitlementCommand}"
                                        Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                        ToolTip="Record discount, free item, or entitlement for selected supplier"/>
                                <Button Content="✨ Add New Supplier"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CreateNewSupplierCommand}"
                                        Padding="8,3" FontSize="11"
                                        ToolTip="Add a new supplier to the system"/>
                            </StackPanel>
                        </Grid>
                        <ComboBox Width="340"
                                  Height="38"
                                  ItemsSource="{Binding Suppliers}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValue="{Binding SelectedSupplierId}"
                                  Tag="Select Supplier">
                            <ComboBox.ToolTip>Choose the supplier providing these products (filters line item products &amp; loads benefits ledger)</ComboBox.ToolTip>
                        </ComboBox>
                        <CheckBox Content="Show all catalog products (bypass supplier filter)"
                                  IsChecked="{Binding ShowAllProducts}"
                                  Margin="0,4,0,0"
                                  FontSize="11"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  ToolTip="Check this to display all products in the catalog even if not listed under this supplier"/>
                        <TextBlock Text="{Binding SupplierError}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding SupplierError, Converter={StaticResource NullToVisibilityConverter}}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Payment Method -->
                    <StackPanel Grid.Column="2">
                        <Grid Width="340" Height="24" Margin="0,0,0,6">
                            <TextBlock Text="Payment Method *" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        </Grid>
                        <ComboBox Width="340"
                                  Height="38"
                                  ItemsSource="{Binding PaymentMethods}"
                                  SelectedItem="{Binding SelectedPaymentMethod}"
                                  Tag="Select Payment Method">
                            <ComboBox.ToolTip>Select payment method used for this transaction</ComboBox.ToolTip>
                        </ComboBox>
                    </StackPanel>

                    <!-- Purchase Notes -->
                    <StackPanel Grid.Column="4">
                        <Grid Width="340" Height="24" Margin="0,0,0,6">
                            <TextBlock Text="Purchase Order Notes / Invoice No." Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox Width="340"
                                 Height="38"
                                 MinHeight="38"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Ex: INV-2026-001 or supplier invoice #"
                                 Style="{StaticResource FormTextBox}"
                                 ToolTip="Optional reference notes or supplier invoice number"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Paid Amount, Remaining Balance, Payment Details -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Paid Amount -->
                    <StackPanel Grid.Column="0">
                        <Grid Width="340" Height="20" Margin="0,0,0,6">
                            <TextBlock Text="Paid Amount (Rs.) *" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox Width="340"
                                 Height="38"
                                 MinHeight="38"
                                 Text="{Binding PaidAmountText, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:DecimalOnlyBehavior.IsEnabled="True"
                                 Style="{StaticResource FormTextBox}"
                                 ToolTip="Amount paid for this transaction (defaults to Total Cost)"/>
                        <TextBlock Text="{Binding PaidAmountError}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding PaidAmountError, Converter={StaticResource NullToVisibilityConverter}}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Remaining Balance -->
                    <StackPanel Grid.Column="2">
                        <Grid Width="340" Height="20" Margin="0,0,0,6">
                            <TextBlock Text="Remaining Balance" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Width="340" Height="38" MinHeight="38" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="10,0">
                            <TextBlock Text="{Binding RemainingBalance, StringFormat='Rs. {0:N2}'}"
                                       FontWeight="Bold" Foreground="#B45309" FontSize="13" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Payment Details -->
                    <StackPanel Grid.Column="4">
                        <Grid Width="340" Height="20" Margin="0,0,0,6">
                            <TextBlock Text="Payment Reference / Details" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox Width="340"
                                 Height="38"
                                 MinHeight="38"
                                 Text="{Binding PaymentDetails, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Ex: Cheque #12345, Bank Ref ABC..."
                                 Style="{StaticResource FormTextBox}"
                                 ToolTip="Optional cheque number, bank transaction ID, or payment notes"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Main Tab Control (Line Items & Supplier Benefits Ledger) ── -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="14" Margin="14,8"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: Stock Purchase Line Items -->
            <TabItem Header="📦 Stock Purchase Line Items">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Line items bar header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Purchase Line Items" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding TotalItemsCount, StringFormat=' ({0} items)'}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="✨ Create New Product"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CreateNewProductCommand}"
                                        Margin="0,0,8,0" Padding="10,6" FontSize="12"
                                        ToolTip="Create a brand new product in the catalog and add to this purchase"/>

                                <Button Content="+ Add Product Row"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AddLineItemCommand}"
                                        Padding="12,6" FontSize="12"
                                        ToolTip="Add another product row to this purchase order"/>
                            </StackPanel>
                        </Grid>

                        <!-- Line Items Table -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LineItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="125"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="85"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="135"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="125"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="125"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Product Selection -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Product *" Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=Page}}"
                                                              SelectedItem="{Binding Product}"
                                                              Height="38"
                                                              DisplayMemberPath="Name"
                                                              Tag="Select Product">
                                                        <ComboBox.ToolTip>Select product to purchase</ComboBox.ToolTip>
                                                    </ComboBox>
                                                    <TextBlock Text="{Binding ProductError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,2,0,0"
                                                               Visibility="{Binding ProductError, Converter={StaticResource NullToVisibilityConverter}}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ClaimedText}" Foreground="#EF4444" FontWeight="SemiBold" FontSize="10" Margin="0,2,0,0"
                                                               Visibility="{Binding HasPendingClaim, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>

                                                <!-- Paid Quantity -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Paid Qty *" Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                             behaviors:IntegerOnlyBehavior.IsEnabled="True"
                                                             Style="{StaticResource FormTextBox}"
                                                             ToolTip="Number of purchased/paid units"/>
                                                    <TextBlock Text="{Binding QuantityError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,2,0,0"
                                                               Visibility="{Binding QuantityError, Converter={StaticResource NullToVisibilityConverter}}" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Free Quantity -->
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Free Qty" Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding FreeQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                             behaviors:IntegerOnlyBehavior.IsEnabled="True"
                                                             Style="{StaticResource FormTextBox}"
                                                             ToolTip="Bonus or free units provided by supplier (excluded from cost)"/>
                                                </StackPanel>

                                                <!-- Claimed Qty Received -->
                                                <StackPanel Grid.Column="6">
                                                    <TextBlock Text="Claimed Recv" Style="{StaticResource LabelText}" FontSize="11" Foreground="#EF4444" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding ClaimedQuantityReceived, UpdateSourceTrigger=PropertyChanged}"
                                                             behaviors:IntegerOnlyBehavior.IsEnabled="True"
                                                             Style="{StaticResource FormTextBox}"
                                                             ToolTip="Claimed warranty replacement stock received from supplier (reduces red claim quantity)"/>
                                                    <TextBlock Text="{Binding ClaimedQtyError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,2,0,0"
                                                               Visibility="{Binding ClaimedQtyError, Converter={StaticResource NullToVisibilityConverter}}" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Unit Cost -->
                                                <StackPanel Grid.Column="8">
                                                    <TextBlock Text="Unit Cost (Rs.)" Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}"
                                                             behaviors:DecimalOnlyBehavior.IsEnabled="True"
                                                             Style="{StaticResource FormTextBox}"
                                                             ToolTip="Cost per paid unit (auto-calculates Total Cost/Discount Rate)"/>
                                                </StackPanel>

                                                <!-- Discount Rate (%) -->
                                                <StackPanel Grid.Column="10">
                                                    <TextBlock Text="Disc. Rate (%)" Style="{StaticResource LabelText}" FontSize="11" Foreground="#C2410C" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding DiscountRateText, UpdateSourceTrigger=PropertyChanged}"
                                                             behaviors:DecimalOnlyBehavior.IsEnabled="True"
                                                             Style="{StaticResource FormTextBox}"
                                                             ToolTip="Discount percentage applied to this line item"/>
                                                </StackPanel>

                                                <!-- Total Cost -->
                                                <StackPanel Grid.Column="12">
                                                    <TextBlock Text="Total Cost (Rs.)" Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding TotalCostText, UpdateSourceTrigger=PropertyChanged}"
                                                             behaviors:DecimalOnlyBehavior.IsEnabled="True"
                                                             Style="{StaticResource FormTextBox}"
                                                             ToolTip="Total purchase cost for this product (auto-calculates Unit Cost/Discount Rate)"/>
                                                </StackPanel>

                                                <!-- Retail Price -->
                                                <StackPanel Grid.Column="14">
                                                    <TextBlock Text="Retail Price (Rs.)" Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding RetailPriceText, UpdateSourceTrigger=PropertyChanged}"
                                                             behaviors:DecimalOnlyBehavior.IsEnabled="True"
                                                             Style="{StaticResource FormTextBox}"
                                                             ToolTip="Update selling retail price for this product"/>
                                                </StackPanel>

                                                <!-- Wholesale Price -->
                                                <StackPanel Grid.Column="16">
                                                    <TextBlock Text="Wholesale Price" Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding WholesalePriceText, UpdateSourceTrigger=PropertyChanged}"
                                                             behaviors:DecimalOnlyBehavior.IsEnabled="True"
                                                             Style="{StaticResource FormTextBox}"
                                                             ToolTip="Update selling wholesale price for this product"/>
                                                </StackPanel>

                                                <!-- Delete Button -->
                                                <StackPanel Grid.Column="18">
                                                    <TextBlock Text=" " Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                                    <Button Content="✕"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding RemoveCommand}"
                                                            Height="38" MinWidth="38" Padding="8,0" FontSize="12"
                                                            VerticalAlignment="Top"
                                                            ToolTip="Remove this item from purchase order"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 2: Supplier Discounts & Free Items Ledger -->
            <TabItem Header="🎁 Supplier Discounts &amp; Free Items Ledger">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Bar for Entitlements -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Supplier Entitlements &amp; Benefits History" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Record and track discounts, free items, and purchase entitlements grouped by product"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="🎁 + Record Discount / Free Item"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RecordEntitlementCommand}"
                                    Padding="14,8" FontSize="12"
                                    ToolTip="Record a new discount or free item entitlement for this supplier"/>
                        </Grid>

                        <!-- Empty State Container when no entitlements exist -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasEntitlements, Converter={StaticResource InvertBoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="No Entitlements Recorded Yet" FontWeight="Bold" FontSize="15" Foreground="#334155" HorizontalAlignment="Center"/>
                                <TextBlock Text="There are no discounts, free items, or entitlements recorded for the selected supplier." Foreground="#64748B" FontSize="12" Margin="0,4,0,16" HorizontalAlignment="Center"/>
                                <Button Content="🎁 Record First Entitlement" Style="{StaticResource PrimaryButton}" Command="{Binding RecordEntitlementCommand}" HorizontalAlignment="Center" Padding="14,8"/>
                            </StackPanel>
                        </Border>

                        <!-- Grouped Product Entitlement Tables -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasEntitlements, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding GroupedEntitlements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Product Heading Bar -->
                                                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Product Title & SKU Code Header -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="#EFF6FF" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                                                                <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="15" Foreground="#0F172A" VerticalAlignment="Center"/>

                                                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ProductCode, StringFormat='Code: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                                            </Border>

                                                            <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasImminentEntitlement, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="⚡ Priority: Imminent Date" FontSize="11" FontWeight="Bold" Foreground="#C2410C"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Group Records Count Badge -->
                                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} Entitlements'}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Product Entitlements Data Table (No Product columns) -->
                                                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column"
                                                          RowBackground="White" AlternatingRowBackground="#FAFAFA" MaxHeight="400">
                                                    <DataGrid.Columns>
                                                        <!-- Status / Nature -->
                                                        <DataGridTemplateColumn Header="Status / Nature" Width="170">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" Background="#EFF6FF">
                                                                        <TextBlock Text="{Binding Nature}" FontWeight="SemiBold" FontSize="11" Foreground="#1D4ED8"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <!-- Quantity / Value -->
                                                        <DataGridTextColumn Header="Quantity / Value" Binding="{Binding DisplayQuantityOrValue}" Width="170"/>

                                                        <!-- Date -->
                                                        <DataGridTextColumn Header="Date" Binding="{Binding EventDate, StringFormat='yyyy-MM-dd'}" Width="120"/>

                                                        <!-- Next Entitlement Date -->
                                                        <DataGridTemplateColumn Header="Next Entitlement Date" Width="200">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Left"
                                                                                Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1"
                                                                                Visibility="{Binding IsImminent, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <TextBlock Text="{Binding NextEntitlementDisplay}" FontWeight="Bold" FontSize="11" Foreground="#C2410C"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding NextEntitlementDisplay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                                                   Visibility="{Binding IsImminent, Converter={StaticResource InvertBoolToVisibilityConverter}}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <!-- Special Notes -->
                                                        <DataGridTextColumn Header="Special Notes" Binding="{Binding SpecialNotes, TargetNullValue='-'}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ── Order Summary & Actions Footer ────────────────── -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Order Totals summary -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Gross Total -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Gross: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding GrossTotal, StringFormat='Rs. {0:N2}'}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Discount Display (Read-Only Summary) -->
                    <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total Disc.: " FontSize="12" FontWeight="SemiBold" Foreground="#C2410C"/>
                            <TextBlock Text="{Binding TotalDiscountAmount, StringFormat='Rs. {0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="#C2410C"/>
                        </StackPanel>
                    </Border>

                    <!-- Net Total Cost -->
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="12,8" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Net Cost: " FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalOrderCost, StringFormat='Rs. {0:N2}'}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Paid Items: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalPaidQuantity}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0"/>

                            <TextBlock Text="Free Items: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalFreeQuantity}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Footer buttons & Error display -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,12,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </Border>

                    <Button Content="Reset Order"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetOrderCommand}"
                            Margin="0,0,10,0" Padding="14,8"/>

                    <Button Content="Save &amp; Receive Stock 📦"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveAndReceiveCommand}"
                            Padding="18,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
