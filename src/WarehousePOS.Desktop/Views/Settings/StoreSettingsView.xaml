<Page x:Class="WarehousePOS.Desktop.Views.Settings.StoreSettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="System &amp; Store Settings"
      KeepAlive="True"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <Style x:Key="SettingsTabRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Header ─────────────────────────────────────────── -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="System &amp; Store Settings" Style="{StaticResource H2}"/>
                <TextBlock Text="Configure store details for sales receipts, manage database backups, and connect Google Drive cloud sync"
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ── In-Page Navigation Tabs ────────────────────────── -->
            <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="8" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="🏪  Receipt &amp; Store Information"
                                 GroupName="SettingsTabs"
                                 IsChecked="{Binding IsStoreTabActive, Mode=TwoWay}"
                                 Style="{StaticResource SettingsTabRadioStyle}"/>
                    <RadioButton Content="💾  Database Backup &amp; Google Drive"
                                 GroupName="SettingsTabs"
                                 IsChecked="{Binding IsBackupTabActive, Mode=TwoWay}"
                                 Style="{StaticResource SettingsTabRadioStyle}"/>
                </StackPanel>
            </Border>

            <!-- ── Tab 1: Store & Receipt Settings ─────────────────── -->
            <Grid Grid.Row="2" Visibility="{Binding IsStoreTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" MaxWidth="640" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Receipt Header &amp; Store Information" Style="{StaticResource H3}" Margin="0,0,0,4"/>
                        <TextBlock Text="Printed at the top and bottom of customer sales receipts"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,16"/>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="0,0,0,12"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <TextBlock Text="Store / Business Name" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,12"/>

                        <TextBlock Text="Store Address" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding StoreAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,12"/>

                        <TextBlock Text="Contact Telephone Numbers" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding StorePhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,12"/>

                        <TextBlock Text="VAT / Tax Registration Number" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TaxRegNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,12"/>

                        <Separator Margin="0,6,0,14"/>

                        <TextBlock Text="Receipt Footer Message" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding FooterMessage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,20"/>

                        <Button Content="Save Receipt Settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Tab 2: Database Backup & Google Drive Cloud ─────── -->
            <Grid Grid.Row="2" Visibility="{Binding IsBackupTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel MaxWidth="920" HorizontalAlignment="Left">

                    <!-- Top Bar: Title & Refresh Button -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Database Backup &amp; Offsite Cloud Storage" Style="{StaticResource H3}"/>
                            <TextBlock Text="All system data is saved to a single master file (WarehousePOS_Backup.zip) locally and synced to Google Drive"
                                       Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔄 Refresh Status" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshBackupsCommand}" Padding="12,6" FontSize="12"/>
                    </Grid>

                    <!-- Pending Cloud Sync Notification (Offline Warning) -->
                    <Border Background="#FEF3C7" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="#F59E0B" BorderThickness="1"
                            Visibility="{Binding IsSyncPending, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚠️" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Cloud Backup Pending (Internet Offline)" FontWeight="Bold" Foreground="#92400E" FontSize="13"/>
                                <TextBlock Text="Your local database backup is saved safely on this PC. As soon as this PC reconnects to the internet, your backup will automatically synchronize to Google Drive."
                                           Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 1. Google Drive Connection Status Card -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="☁️" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Google Drive Cloud Connection" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding ConnectedEmail, StringFormat='Connected Account: {0}'}"
                                               Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0"
                                               Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="Not Connected (Backups are currently saved on this computer only)"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"
                                               Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                </StackPanel>

                                <!-- Disconnect Button -->
                                <Button Grid.Column="2" Content="Disconnect" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DisconnectDriveCommand}" Padding="14,6" FontSize="12"
                                        Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>

                            <!-- OAuth Credentials Form (shown only when disconnected) -->
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Separator Margin="0,0,0,14"/>
                                <TextBlock Text="Google Drive OAuth Setup" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="Enter your Google Cloud credentials below (or place client_secret.json inside C:\ProgramData\WarehousePOS\Secrets\):"
                                           Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Client ID" Style="{StaticResource FormLabel}"/>
                                        <TextBox Text="{Binding ClientIdInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Client Secret" Style="{StaticResource FormLabel}"/>
                                        <TextBox Text="{Binding ClientSecretInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="🔑 Connect Google Drive" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ConnectDriveCommand}" HorizontalAlignment="Left" Padding="16,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Manual Backup Trigger Card -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Manual Database Backup" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="Creates an instant backup locally and uploads the updated file directly to Google Drive"
                                               Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="💾 Backup Now" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding BackupNowCommand}" Padding="20,10"/>
                            </Grid>

                            <!-- Real-time Progress Bar & Status -->
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding BackupStatusText, Converter={StaticResource NullToVisibilityConverter}}">
                                <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding BackupProgress}"
                                             Foreground="{StaticResource PrimaryBrush}" Background="#E5E7EB" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding BackupStatusText}" Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. Backup Path & Storage Status -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Local Destination Info -->
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="📁 Local Backup Destination" Style="{StaticResource FormLabel}"/>
                                <TextBlock Text="{Binding LastLocalBackupDisplay}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="Saved at: C:\ProgramData\WarehousePOS\Backups\" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Google Drive Cloud Info -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="☁️ Google Drive Destination" Style="{StaticResource FormLabel}"/>
                                <TextBlock Text="{Binding LastCloudBackupDisplay}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="Folder: Google Drive > WarehousePOS_Backups" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 4. Recent Backups Table -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Recent Local Snapshots (Last 10)" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding RecentLocalBackups}" MaxHeight="220" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="110"/>
                                    <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding DateDisplay}" Width="160"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
