<Page x:Class="WarehousePOS.Desktop.Views.Settings.StoreSettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Store Configuration &amp; Cloud Backup"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Store Configuration &amp; Cloud Backup" Style="{StaticResource H2}"/>
                <TextBlock Text="Manage receipt details, local database backups, and offsite Google Drive cloud synchronization"
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Column 0: Store & Receipt Settings ───────────── -->
                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Receipt Header &amp; Store Information" Style="{StaticResource H3}" Margin="0,0,0,4"/>
                        <TextBlock Text="Printed at the top and bottom of customer sales receipts"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,16"/>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="0,0,0,12"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <TextBlock Text="Store / Business Name" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,12"/>

                        <TextBlock Text="Store Address" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding StoreAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,12"/>

                        <TextBlock Text="Contact Telephone Numbers" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding StorePhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,12"/>

                        <TextBlock Text="VAT / Tax Registration Number" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TaxRegNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,12"/>

                        <Separator Margin="0,6,0,14"/>

                        <TextBlock Text="Receipt Footer Message" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding FooterMessage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,20"/>

                        <Button Content="Save Receipt Settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- ── Column 2: Database Backup & Google Drive Cloud ── -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Database Backup &amp; Google Drive Sync" Style="{StaticResource H3}"/>
                                <TextBlock Text="Single main backup file (WarehousePOS_Backup.zip) maintained forever locally and on Google Drive"
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="🔄 Refresh" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshBackupsCommand}" Padding="10,4" FontSize="12"/>
                        </Grid>

                        <!-- Pending Cloud Sync Notification (when offline) -->
                        <Border Background="#FEF3C7" CornerRadius="8" Padding="12" Margin="0,10,0,14" BorderBrush="#F59E0B" BorderThickness="1"
                                Visibility="{Binding IsSyncPending, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Internet offline: Local backup is saved safely on this PC. Cloud backup will automatically upload when internet reconnects."
                                           Foreground="#92400E" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Google Drive Account Status Banner -->
                        <Border Background="#F3F4F6" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status indicator icon & text -->
                                    <TextBlock Grid.Column="0" Text="☁️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Google Drive Cloud Status" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding ConnectedEmail, StringFormat='Connected: {0}'}"
                                                   Foreground="{StaticResource SuccessBrush}" FontWeight="Medium" FontSize="12"
                                                   Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="Not Connected (Backups are stored locally on PC only)"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Connect/Disconnect Action Button -->
                                    <Button Grid.Column="2" Content="Disconnect" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DisconnectDriveCommand}" Padding="12,6" FontSize="12"
                                            Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>

                                <!-- OAuth configuration inputs when not connected -->
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="Enter Google Cloud OAuth credentials (or place client_secret.json in C:\ProgramData\WarehousePOS\Secrets\):"
                                               Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Client ID" Style="{StaticResource FormLabel}"/>
                                            <TextBox Text="{Binding ClientIdInput, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBox}" FontSize="12" Padding="6,4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Client Secret" Style="{StaticResource FormLabel}"/>
                                            <TextBox Text="{Binding ClientSecretInput, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBox}" FontSize="12" Padding="6,4"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="🔑 Connect Google Drive" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ConnectDriveCommand}" HorizontalAlignment="Left" Padding="14,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Backup Action Section -->
                        <Border Background="#F9FAFB" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Update Database Backup" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="Updates the main backup file locally and synchronizes it to Google Drive"
                                                   Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="💾 Backup Now" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding BackupNowCommand}" Padding="18,10"/>
                                </Grid>

                                <!-- Progress bar & Status text -->
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding BackupStatusText, Converter={StaticResource NullToVisibilityConverter}}">
                                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding BackupProgress}"
                                                 Foreground="{StaticResource PrimaryBrush}" Background="#E5E7EB" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding BackupStatusText}" Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Backup Summary Statistics -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="📁 Latest Local Backup" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="{Binding LastLocalBackupDisplay}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="Folder: C:\ProgramData\WarehousePOS\Backups\" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="☁️ Latest Google Drive Backup" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="{Binding LastCloudBackupDisplay}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="Folder: Google Drive > WarehousePOS_Backups" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Recent Backups Table -->
                        <TextBlock Text="Recent Local Snapshots (Last 10)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding RecentLocalBackups}" MaxHeight="220" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding DateDisplay}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
