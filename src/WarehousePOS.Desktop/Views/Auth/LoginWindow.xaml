<Window x:Class="WarehousePOS.Desktop.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warehouse POS — Login"
        MinHeight="600"
        MinWidth="820"
        Height="720"
        Width="1280"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#101820">

    <Grid>
        <!-- Local retail/POS image keeps the login usable offline. -->
        <Image Source="/WarehousePOS.Desktop;component/Resources/Images/pos-retail-background.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- Soft dark veil maintains contrast over bright store details. -->
        <Border Background="#B8101820" />

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="24">
            <Border Width="430"
                    MaxWidth="430"
                    Padding="38,34,38,30"
                    Background="#F7FFFFFF"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Effect="{StaticResource LoginCardShadow}">
                <StackPanel>

                    <!-- Official Happy Products logo stored as a local resource. -->
                    <Border MaxWidth="280"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18">
                        <Image Source="{StaticResource HappyProductsLogo}"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <TextBlock Text="Warehouse POS"
                               Style="{StaticResource H2}"
                               HorizontalAlignment="Center"
                               FontSize="25"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Sign in to continue"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28" />

                    <!-- Username -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Username"
                                   Style="{StaticResource LabelText}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="UsernameBox"
                                 Style="{StaticResource FormTextBox}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Password"
                                   Style="{StaticResource LabelText}"
                                   Margin="0,0,0,6" />
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource FormPasswordBox}"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                     KeyDown="PasswordBox_KeyDown" />
                    </StackPanel>

                    <!-- Existing validation/error message. -->
                    <Border Background="#15E02424"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Existing login command/event wiring is preserved. -->
                    <Button Content="Sign In"
                            Style="{StaticResource PrimaryButton}"
                            Height="46"
                            x:Name="LoginButton"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                            Click="LoginButton_Click" />

                    <TextBlock Text="Signing in..."
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="Warehouse POS  |  Happy Products"
                   Foreground="#D9FFFFFF"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,22" />

    </Grid>
</Window>
