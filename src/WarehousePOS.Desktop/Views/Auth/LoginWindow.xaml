<Window x:Class="WarehousePOS.Desktop.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warehouse POS — Login"
        Height="480"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Login card -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Margin="40,40,40,20"
                VerticalAlignment="Center">

            <StackPanel Spacing="20">

                <!-- Logo / title -->
                <StackPanel HorizontalAlignment="Center"
                            Margin="0,0,0,8">
                    <TextBlock Text="📦"
                               FontSize="40"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Warehouse POS"
                               Style="{StaticResource H2}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Sign in to continue"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Username -->
                <StackPanel>
                    <TextBlock Text="Username"
                               Style="{StaticResource LabelText}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="UsernameBox"
                             Style="{StaticResource FormTextBox}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />
                </StackPanel>

                <!-- Password -->
                <StackPanel>
                    <TextBlock Text="Password"
                               Style="{StaticResource LabelText}"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource FormPasswordBox}"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />
                </StackPanel>

                <!-- Error message -->
                <Border Background="#FEF2F2"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Login button -->
                <Button Content="Sign In"
                        Style="{StaticResource PrimaryButton}"
                        Height="44"
                        x:Name="LoginButton"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                        Click="LoginButton_Click"/>

                <!-- Busy indicator -->
                <TextBlock Text="Signing in…"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="1"
                   Text="Warehouse POS v1.0"
                   Style="{StaticResource CaptionText}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>
    </Grid>
</Window>
