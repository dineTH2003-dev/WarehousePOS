<Window x:Class="WarehousePOS.Desktop.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WarehousePOS.Desktop.Behaviors"
        Title="Happy Products — Login"
        Icon="/Resources/Images/app-icon.png"
        MinHeight="600"
        MinWidth="820"
        Height="720"
        Width="1280"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#101820">

    <Grid>
        <!-- Local retail/POS image keeps the login usable offline. -->
        <Image Source="/WarehousePOS.Desktop;component/Resources/Images/pos-retail-background.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- Soft dark veil maintains contrast over bright store details. -->
        <Border Background="#B8101820" />

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="24"
              behaviors:ArrowNavigationBehavior.IsEnabled="True">
            <Border Width="430"
                    MaxWidth="430"
                    Padding="38,34,38,30"
                    Background="#F7FFFFFF"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Effect="{StaticResource LoginCardShadow}">
                <StackPanel>

                    <!-- Official Happy Products logo stored as a local resource. -->
                    <Border MaxWidth="260"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8">
                        <Image Source="{StaticResource HappyProductsLogo}"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <TextBlock Text="Sign in to continue"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <!-- Username -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Username"
                                   Style="{StaticResource LabelText}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="UsernameBox"
                                 Style="{StaticResource FormTextBox}"
                                 Height="42"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                 KeyDown="UsernameBox_KeyDown" />
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Password"
                                   Style="{StaticResource LabelText}"
                                   Margin="0,0,0,6" />
                        <Border x:Name="PasswordContainer"
                                Height="42"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Masked Password -->
                                <PasswordBox x:Name="PasswordBox"
                                             Grid.Column="0"
                                             FontSize="14"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                             PasswordChanged="PasswordBox_PasswordChanged"
                                             GotFocus="PasswordControl_GotFocus"
                                             LostFocus="PasswordControl_LostFocus"
                                             KeyDown="PasswordControl_KeyDown" />

                                <!-- Plain Text Password (when eye icon toggled) -->
                                <TextBox x:Name="PasswordTextBox"
                                         Grid.Column="0"
                                         FontSize="14"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         Visibility="Collapsed"
                                         IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                         TextChanged="PasswordTextBox_TextChanged"
                                         GotFocus="PasswordControl_GotFocus"
                                         LostFocus="PasswordControl_LostFocus"
                                         KeyDown="PasswordControl_KeyDown" />

                                <!-- Eye Icon Toggle Button -->
                                <Button x:Name="TogglePasswordButton"
                                        Grid.Column="1"
                                        Style="{StaticResource PasswordEyeToggleButtonStyle}"
                                        Margin="0,0,3,0"
                                        ToolTip="Show password"
                                        Click="TogglePasswordButton_Click">
                                    <Path x:Name="EyeIconPath"
                                          Data="{StaticResource EyeOpenIcon}"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          Width="18"
                                          Height="18"
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Existing validation/error message. -->
                    <Border Background="#15E02424"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Existing login command/event wiring is preserved. -->
                    <Button Content="Sign In"
                            Style="{StaticResource PrimaryButton}"
                            Height="46"
                            x:Name="LoginButton"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                            Click="LoginButton_Click"
                            KeyDown="LoginButton_KeyDown" />

                    <TextBlock Text="Signing in..."
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="© 2026 Happy Products • All Rights Reserved"
                   Foreground="#D9FFFFFF"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,22" />

    </Grid>
</Window>
