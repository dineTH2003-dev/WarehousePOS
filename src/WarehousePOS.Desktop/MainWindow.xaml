<Window x:Class="WarehousePOS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warehouse POS"
        Height="768"
        Width="1280"
        WindowState="Maximized"
        MinHeight="600"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Sidebar nav button style -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="#1E293B"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="16,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="FontFamily"        Value="Segoe UI"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="8,2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F7EE"/>
                                <Setter Property="Foreground" Value="#0F7F4F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D1F2DF"/>
                                <Setter Property="Foreground" Value="#0A5C39"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar logout button style -->
        <Style x:Key="LogoutNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="8,2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                                <Setter Property="Foreground" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ─────────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- App logo / user info -->
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,16">
                    <Border Width="180"
                            MaxWidth="180"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,6">
                        <Image Source="{StaticResource HappyProductsLogo}"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock x:Name="UserLabel"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="2,2,0,0"/>
                </StackPanel>

                <Separator DockPanel.Dock="Top" Background="{StaticResource BorderBrush}" Margin="16,0,16,12"/>

                <!-- Logout at bottom -->
                <Button x:Name="BtnLogout"
                        DockPanel.Dock="Bottom"
                        Content="⬅  Logout"
                        Style="{StaticResource LogoutNavButton}"
                        Margin="0,0,0,16"
                        Click="BtnLogout_Click"/>

                <Separator DockPanel.Dock="Bottom" Background="{StaticResource BorderBrush}" Margin="16,0,16,8"/>

                <!-- Navigation items -->
                <StackPanel>
                    <Button x:Name="BtnPos"
                            Content="🖥️  Point of Sale"
                            Style="{StaticResource NavButton}"
                            Click="BtnPos_Click"/>
                    <Button x:Name="BtnProducts"
                            Content="📦  Products"
                            Style="{StaticResource NavButton}"
                            Click="BtnProducts_Click"/>
                    <Button x:Name="BtnPurchasing"
                            Content="🛒  Purchasing"
                            Style="{StaticResource NavButton}"
                            Click="BtnPurchasing_Click"/>
                    <Button x:Name="BtnSuppliers"
                            Content="🚚  Suppliers"
                            Style="{StaticResource NavButton}"
                            Click="BtnSuppliers_Click"/>
                    <Button x:Name="BtnCustomers"
                            Content="👥  Customers"
                            Style="{StaticResource NavButton}"
                            Click="BtnCustomers_Click"/>

                    <Separator Background="{StaticResource BorderBrush}" Margin="16,8"/>

                    <Button x:Name="BtnReports"
                            Content="📊  Reports"
                            Style="{StaticResource NavButton}"
                            Click="BtnReports_Click"/>
                    <Button x:Name="BtnExpenses"
                            Content="💸  Expenses"
                            Style="{StaticResource NavButton}"
                            Click="BtnExpenses_Click"/>
                            <Button x:Name="BtnUserManagement"
                                Content="🔐  User Management"
                                Style="{StaticResource NavButton}"
                                Click="BtnUserManagement_Click"/>

                    <Separator Background="{StaticResource BorderBrush}" Margin="16,8"/>

                    <Button x:Name="BtnSettings"
                            Content="⚙️  Settings"
                            Style="{StaticResource NavButton}"
                            Click="BtnSettings_Click"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ── Main content Area ────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Offline Cloud Backup Notification Banner -->
            <Border x:Name="CloudSyncNoticeBanner" Grid.Row="0" Background="#FEF3C7" BorderBrush="#F59E0B"
                    BorderThickness="0,0,0,1" Padding="14,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CloudSyncNoticeText" Grid.Column="1"
                               Text="Internet offline: Local backup is saved safely on this PC. Cloud backup will automatically upload when internet reconnects."
                               Foreground="#92400E" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Main content Frame -->
            <Frame Grid.Row="1"
                   x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
